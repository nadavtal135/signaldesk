# Python environment and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Never commit secrets or local settings
.env
.env.*
*.pem
*.key
.claude/settings.local.json

# OS / editor clutter
.DS_Store
*.log

# Large intermediate files, regenerated by scripts 15, 17 and 25
figures/benchmark_losses.csv
figures/phase5_forecasts.csv
figures/phase6_forecasts.csv

# Fresh prices for the forward test (downloaded by scripts/score_forward.py)
data/forward/

# Price data from Yahoo Finance is not redistributed in this repo.
# Download it with scripts/01_download_prices.py and scripts/23_phase6_download.py,
# then check it against data/CHECKSUMS.sha256 with scripts/00_verify_data.py.
data/raw/*.csv
data/raw_phase6/*.csv
